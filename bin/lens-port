#!/usr/bin/env python3
"""lens-port — codex-lens 포트 관리자를 부르는 명령(표준 라이브러리만, macOS·Linux).

    lens-port run [--name N] [--cwd D] [--port P] [--wait SEC] [--no-wait] -- <명령…>   ({port}·{host} 를 바꿔 넣는다)
    lens-port run [--name N] --sh '<셸 명령>'                                         ($PORT·$CODEX_LENS_BIND 를 쓴다)
    lens-port list [--all] [--json]
    lens-port stop <ID|포트>
    lens-port logs <ID|포트> [--bytes N]
    lens-port free

앱 주소: 환경변수 CODEX_LENS_URL → CODEX_LENS_HOME/server.json → ~/.codex-lens/server.json → http://127.0.0.1:8761
"""

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request

STATE = {"starting": "여는 중", "listening": "열림", "exited": "끝남", "stopped": "꺼짐"}


def base_url():
    if os.environ.get("CODEX_LENS_URL"):
        return os.environ["CODEX_LENS_URL"].rstrip("/")
    homes = [os.environ.get("CODEX_LENS_HOME"), "~/.codex-lens"]
    for h in homes:
        if not h:
            continue
        try:
            with open(os.path.join(os.path.expanduser(h), "server.json")) as f:
                return json.load(f)["url"].rstrip("/")
        except (OSError, ValueError, KeyError):
            pass
    return "http://127.0.0.1:8761"


def call(method, path, body=None, timeout=30):
    url = base_url() + path
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8") or "{}")
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read().decode("utf-8")).get("error")
        except ValueError:
            msg = None
        die(msg or "HTTP %d" % e.code)
    except (urllib.error.URLError, OSError) as e:
        die("codex-lens(%s)에 닿지 않습니다 — 앱이 떠 있는지 확인하세요: %s" % (base_url(), getattr(e, "reason", e)))


def die(msg, code=1):
    print("lens-port: " + str(msg), file=sys.stderr)
    sys.exit(code)


def local_url(e):
    return "http://127.0.0.1:%d/" % e["port"]


def line(e):
    s = STATE.get(e.get("state"), e.get("state"))
    if e.get("state") == "exited" and e.get("exit_code") is not None:
        s += "(코드 %s)" % e["exit_code"]
    return "%-10s %-6s %-8s %-14s %s%s" % (e["id"], e["port"], s, (e.get("name") or "")[:14], e.get("cmd") or "",
                                         "  → " + e["url"] if e.get("url") else "")


def tail(pid, n=3000):
    return (call("GET", "/api/ports/%s/log?bytes=%d" % (pid, n)) or {}).get("text") or ""


_INFO = {}


def r_info():
    if not _INFO:
        r = call("GET", "/api/ports?thread=-")
        _INFO.update({k: r.get(k) for k in ("range", "bind", "public_url", "expose")})
    return _INFO


def cmd_run(a, rest):
    if rest and rest[0] == "--":
        rest = rest[1:]
    if not rest and not a.sh:
        die("띄울 명령이 없습니다 — lens-port run --name web -- <명령…>", 2)
    body = {"name": a.name, "cwd": os.path.abspath(a.cwd or os.getcwd()), "env": dict(os.environ),
            "thread_id": os.environ.get("CODEX_THREAD_ID") or None, "replace": not a.keep}
    if a.sh:
        body["sh"] = a.sh
    else:
        body["argv"] = rest
    if a.port:
        body["port"] = a.port
    e = call("POST", "/api/ports", body)
    print("포트 %d 을(를) 잡고 띄웠습니다 · ID %s · 바인드 %s" % (e["port"], e["id"], e.get("bind")), flush=True)
    if a.no_wait:
        print(local_url(e))
        return 0
    end = time.time() + a.wait
    while time.time() < end:
        time.sleep(0.5)
        e = call("GET", "/api/ports/" + e["id"])
        if e["state"] == "listening":
            # 바깥 주소를 붙이는 중이면(CODEX_LENS_PORT_EXPOSE) 잠깐 더 기다린다
            hold = time.time() + 25
            while (e.get("expose") in (None, "pending") and r_info().get("expose")) and time.time() < hold:
                time.sleep(0.5)
                e = call("GET", "/api/ports/" + e["id"])
            print("열림 — %s  (로그 %s)" % (local_url(e), e.get("log")))
            if e.get("url"):
                print("다른 기기에서 열 주소 — %s" % e["url"])
            elif e.get("expose") == "failed":
                print("바깥 주소를 붙이지 못했습니다: %s" % (e.get("expose_error") or ""), file=sys.stderr)
            return 0
        if e["state"] in ("exited", "stopped"):
            print("포트를 열기 전에 끝났습니다(코드 %s). 로그 끝:" % e.get("exit_code"), file=sys.stderr)
            print(tail(e["id"]), file=sys.stderr)
            return 1
    print("%d초 안에 포트 %d 이(가) 열리지 않았습니다 — 프로세스는 계속 돕니다. 명령이 {port}·$PORT 를 쓰는지 확인하세요. 로그 끝:"
          % (a.wait, e["port"]), file=sys.stderr)
    print(tail(e["id"]), file=sys.stderr)
    return 3


def cmd_list(a, rest):
    r = call("GET", "/api/ports")
    items = [e for e in r["items"] if a.all or e["state"] in ("starting", "listening")]
    if a.json:
        print(json.dumps(items, ensure_ascii=False, indent=1))
        return 0
    if not items:
        print("띄운 서버가 없습니다 (대역 %d-%d)" % tuple(r["range"]))
        return 0
    for e in items:
        print(line(e))
    return 0


def cmd_stop(a, rest):
    e = call("POST", "/api/ports/%s/stop" % a.target)
    print("꺼짐 — %s 포트 %d" % (e["id"], e["port"]))
    return 0


def cmd_logs(a, rest):
    sys.stdout.write(tail(a.target, a.bytes))
    return 0


def cmd_free(a, rest):
    r = call("GET", "/api/ports/free")
    print(r["port"])
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="lens-port", description="codex-lens 포트 관리 — 빈 포트로 서버를 띄우고 보고 끈다")
    sp = p.add_subparsers(dest="cmd", required=True)
    r = sp.add_parser("run", help="빈 포트를 골라 서버를 띄운다")
    r.add_argument("--name", help="짧은 이름(같은 세션에서 같은 이름이면 이전 것을 끄고 다시 띄운다)")
    r.add_argument("--cwd", help="작업 폴더(기본: 지금 폴더)")
    r.add_argument("--port", type=int, help="이 포트를 쓴다(비어 있어야 한다)")
    r.add_argument("--sh", help="셸 명령으로 띄운다")
    r.add_argument("--wait", type=float, default=90, help="포트가 열릴 때까지 기다릴 초(기본 90)")
    r.add_argument("--no-wait", action="store_true", help="기다리지 않는다")
    r.add_argument("--keep", action="store_true", help="같은 이름의 이전 서버를 끄지 않는다")
    ls = sp.add_parser("list", help="띄운 서버 목록")
    ls.add_argument("--all", action="store_true", help="끝난 것도 보인다")
    ls.add_argument("--json", action="store_true")
    st = sp.add_parser("stop", help="끈다")
    st.add_argument("target", help="ID 또는 포트")
    lg = sp.add_parser("logs", help="출력 끝을 본다")
    lg.add_argument("target", help="ID 또는 포트")
    lg.add_argument("--bytes", type=int, default=8000)
    sp.add_parser("free", help="빈 포트 번호 하나(2분 동안 다른 요청에 주지 않는다)")
    argv = sys.argv[1:] if argv is None else argv
    # run 뒤의 "--" 이후는 띄울 명령이다 — argparse 가 그 안의 옵션을 먹지 않게 먼저 잘라 둔다
    rest = []
    if "--" in argv:
        i = argv.index("--")
        argv, rest = argv[:i], argv[i + 1:]
    a, extra = p.parse_known_args(argv)
    if extra and a.cmd != "run":
        p.error("알 수 없는 인자: %s" % " ".join(extra))
    rest = extra + rest if a.cmd == "run" else rest
    return {"run": cmd_run, "list": cmd_list, "stop": cmd_stop, "logs": cmd_logs, "free": cmd_free}[a.cmd](a, rest)


if __name__ == "__main__":
    sys.exit(main())
